# The R package with reticulate available but NO Python engine installed.
# Proves the package loads, documents build, and every engine-dependent test
# skips cleanly rather than failing.
FROM longbet-r:reticulate
WORKDIR /src
COPY . /src
RUN R CMD INSTALL --no-multiarch /src
CMD ["bash", "-lc", "cd /tmp && R CMD build /src >/dev/null 2>&1 && _R_CHECK_FORCE_SUGGESTS_=0 R CMD check --no-manual --no-build-vignettes longbet_*.tar.gz 2>&1 | tail -25"]
