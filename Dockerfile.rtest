# Test image for the R front door: the R package plus the Python engine it drives.
#
#   docker build -f Dockerfile.rtest -t longbet-rtest .
#   docker run --rm longbet-rtest                      # testthat suite
#   docker run --rm longbet-rtest bash -lc \
#     'cd /tmp && R CMD build /src && R CMD check --no-manual longbet_*.tar.gz'
#
# Dockerfile.rtest-nopython is the companion that proves the package still
# checks cleanly with no Python engine installed at all.
FROM longbet-r:reticulate

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends python3-venv \
    && rm -rf /var/lib/apt/lists/*

# One virtualenv holding the engine; reticulate is pointed straight at it, so
# the tests exercise the same path a user gets from use_virtualenv().
ENV VIRTUAL_ENV=/opt/longbet-venv
RUN python3 -m venv $VIRTUAL_ENV
ENV PATH="$VIRTUAL_ENV/bin:$PATH"
ENV RETICULATE_PYTHON="$VIRTUAL_ENV/bin/python"

WORKDIR /src
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir --upgrade pip && pip install --no-cache-dir .

COPY . /src
RUN R CMD INSTALL --no-multiarch --with-keep.source /src

CMD ["Rscript", "-e", "testthat::test_local('/src', reporter='summary')"]
